@page "/"
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Dandelions</PageTitle>

<div class="dandelions-app">
    <header class="app-header">
        <h1>Dandelions</h1>
        <div class="header-meta">
            <output id="total-points" class="total-count" aria-live="polite">@TotalPoints.ToString("N0") points</output>
            <a class="code-link" href="https://github.com/zackJKnight/blazor-dandelions" aria-label="See the Code">Code</a>
        </div>
    </header>

    <main id="drawing-surface"
          class="canvas-container"
          role="button"
          tabindex="0"
          aria-label="Animated drawing. Tap to add ten dandelions. Use arrow keys to adjust the count."
          @onclick="OnTouched"
          @onkeydown="HandleKeyDown">
        <canvas id="gpu-canvas" @ref="canvasElement" aria-label="GPU animated dandelions using WebGL2"></canvas>
        @if (gpuError is not null)
        {
            <p class="gpu-error" role="alert">@gpuError</p>
        }
        @if (!hasTappedCanvas)
        {
            <span class="canvas-hint" aria-hidden="true">Tap drawing to add 10</span>
        }
        @if (gpuReady)
        {
            <span class="gpu-label" aria-label="GPU renderer active">WebGL2 GPU</span>
        }
        <output id="fps-display" class="fps-indicator" aria-label="Approximate frame rate" title="Browser animation frames per second; low is the minimum over recent samples">FPS @(hasFrameRateSample ? displayedFps.ToString() : "—")@if (hasFrameRateSample) { <text> · low @lowestRecentFps</text> }</output>
    </main>

    <section class="controls-panel" aria-label="Drawing controls">
        <div class="points-control">
            <label for="points-slider">Points</label>
            <input id="points-slider"
                   class="points-slider"
                   type="range"
                   aria-label="Points per dandelion"
                   min="5"
                   max="500"
                   step="5"
                   @bind="numberOfPoints"
                   @bind:event="oninput" />
            <output id="points-value" for="points-slider">@numberOfPoints</output>
        </div>
        <div class="count-actions">
            <div class="count-editor">
                <span class="count-label">Count</span>
                <div class="count-stepper" role="group" aria-label="Dandelion count">
                    <button id="remove-one" class="stepper-button" type="button"
                            aria-label="Remove one dandelion"
                            disabled="@(numberOfDandies == 0)"
                            @onclick="() => ChangeDandelions(-1)">−</button>
                    <input id="dandelion-count"
                           class="count-input"
                           type="number"
                           inputmode="numeric"
                           aria-label="Number of dandelions"
                           min="0"
                           max="500"
                           step="1"
                           @bind="DandelionCount" />
                    <button id="add-one" class="stepper-button" type="button"
                            aria-label="Add one dandelion"
                            disabled="@(numberOfDandies == 500)"
                            @onclick="() => ChangeDandelions(1)">+</button>
                </div>
            </div>
            <div class="quick-actions">
                <button id="add-ten" class="secondary-button" type="button"
                        disabled="@(numberOfDandies == 500)"
                        @onclick="() => ChangeDandelions(10)">+10</button>
                <button id="clear-button" class="clear-button" type="button"
                        disabled="@(numberOfDandies == 0)"
                        @onclick="OnClear">Clear</button>
            </div>
        </div>
    </section>
</div>

@code
{
    private const double GoldenRatio = 1.61803398874989484820458683436;
    private const float PointScale = 30f;
    private const int MaxFlowers = 500;

    private static readonly uint[] Palette =
    [
        0x9ACD32, 0x008000, 0xEE82EE, 0xF5F5F5, 0xFF6347,
        0x008080, 0x708090, 0x87CEEB, 0xFF0000, 0x800080,
        0xFFC0CB, 0xDDA0DD, 0xFFDAB9, 0x98FB98, 0xFFA500,
        0x000080, 0x00FF00
    ];

    private readonly Random random = new();
    private readonly List<Dandelion> dandelions = [];
    private ElementReference canvasElement;
    private IJSObjectReference? module;
    private IJSObjectReference? renderer;
    private DotNetObjectReference<Index>? dotNetRef;

    private int numberOfPoints = 20;
    private int numberOfDandies = 1;
    private int uploadedPointCount = -1;
    private int uploadedDandelionCount = -1;
    private bool hasTappedCanvas;
    private bool gpuReady;
    private bool hasFrameRateSample;
    private int displayedFps;
    private int lowestRecentFps;
    private string? gpuError;

    private int TotalPoints => numberOfPoints * numberOfDandies;
    private int DandelionCount
    {
        get => numberOfDandies;
        set => numberOfDandies = Math.Clamp(value, 0, MaxFlowers);
    }

    private void OnTouched()
    {
        hasTappedCanvas = true;
        ChangeDandelions(10);
    }

    private void ChangeDandelions(int count) =>
        numberOfDandies = Math.Clamp(numberOfDandies + count, 0, MaxFlowers);

    private void OnClear() => numberOfDandies = 0;

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight")
            ChangeDandelions(1);
        else if (e.Key == "ArrowLeft")
            ChangeDandelions(-1);
        else if (e.Key == "Enter")
            OnTouched();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dandelions-gpu.js");
                dotNetRef = DotNetObjectReference.Create(this);
                renderer = await module.InvokeAsync<IJSObjectReference>("createRenderer", canvasElement, dotNetRef);
                gpuReady = true;
                await InvokeAsync(StateHasChanged);
            }

            if (renderer is not null &&
                (numberOfPoints != uploadedPointCount || numberOfDandies != uploadedDandelionCount))
            {
                UpdateDandelionCount();
                var geometry = numberOfPoints != uploadedPointCount
                    ? BuildPointGeometry(numberOfPoints)
                    : Array.Empty<float>();
                var instances = BuildInstances();

                // Geometry is uploaded only when the points slider changes.
                // The per-flower data is uploaded only when the count changes.
                await renderer.InvokeVoidAsync("setScene", geometry, instances);

                uploadedPointCount = numberOfPoints;
                uploadedDandelionCount = numberOfDandies;
            }
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            gpuReady = false;
            gpuError = $"GPU initialization failed: {exception.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void UpdateDandelionCount()
    {
        while (dandelions.Count < numberOfDandies)
        {
            var index = dandelions.Count;
            float speed = (index <= 15 ? index + 1 : index % 15 + 1) * 60f;
            dandelions.Add(new Dandelion
            {
                SeedX = 2f * random.NextSingle() - 1f,
                SeedY = 2f * random.NextSingle() - 1f,
                VelocityX = speed * (random.Next(2) == 0 ? -1f : 1f),
                VelocityY = speed * (random.Next(2) == 0 ? -1f : 1f),
                ColorRgb = Palette[random.Next(Palette.Length)]
            });
        }
        if (dandelions.Count > numberOfDandies)
            dandelions.RemoveRange(numberOfDandies, dandelions.Count - numberOfDandies);
    }

    private static float[] BuildPointGeometry(int count)
    {
        var points = new float[count * 2];
        for (int k = 1; k <= count; k++)
        {
            var radius = Math.Sqrt((k - 0.5) / (count - 0.5));
            var theta = 2.0 * Math.PI * k / (GoldenRatio * GoldenRatio);
            points[(k - 1) * 2] = PointScale * (float)(radius * Math.Cos(theta));
            points[(k - 1) * 2 + 1] = PointScale * (float)(radius * Math.Sin(theta));
        }
        return points;
    }

    private float[] BuildInstances()
    {
        // Each instance contains a seed position, a velocity, and an RGB color.
        var data = new float[dandelions.Count * 7];
        for (int i = 0; i < dandelions.Count; i++)
        {
            var flower = dandelions[i];
            int offset = i * 7;
            data[offset] = flower.SeedX;
            data[offset + 1] = flower.SeedY;
            data[offset + 2] = flower.VelocityX;
            data[offset + 3] = flower.VelocityY;
            data[offset + 4] = ((flower.ColorRgb >> 16) & 255) / 255f;
            data[offset + 5] = ((flower.ColorRgb >> 8) & 255) / 255f;
            data[offset + 6] = (flower.ColorRgb & 255) / 255f;
        }
        return data;
    }

    [JSInvokable]
    public Task ReportFrameRate(int fps, int recentLow) =>
        InvokeAsync(() =>
        {
            displayedFps = fps;
            lowestRecentFps = recentLow;
            hasFrameRateSample = true;
            StateHasChanged();
        });

    public async ValueTask DisposeAsync()
    {
        if (renderer is not null)
        {
            try { await renderer.InvokeVoidAsync("dispose"); }
            catch (JSDisconnectedException) { }
            await renderer.DisposeAsync();
        }
        if (module is not null)
            await module.DisposeAsync();
        dotNetRef?.Dispose();
    }
}
