@page "/"
@using SkiaSharp
@using SkiaSharp.Views.Blazor
@using System.Diagnostics
@implements IDisposable

<PageTitle>Dandelions</PageTitle>

<div class="dandelions-app">
    <header class="app-header">
        <h1>Dandelions</h1>
        <output id="total-points" class="total-count" aria-live="polite">@TotalPoints.ToString("N0") points</output>
    </header>

    <main id="drawing-surface"
          class="canvas-container"
          role="button"
          tabindex="0"
          aria-label="Animated drawing. Tap to add ten dandelions. Use arrow keys to adjust the count."
          @onclick="OnTouched"
          @onkeydown="HandleKeyDown">
        <SKGLView OnPaintSurface="OnPaintSurface" IgnorePixelScaling="true" EnableRenderLoop="true" />
        <span class="canvas-hint" aria-hidden="true">Tap drawing to add 10</span>
        <output id="fps-display" class="fps-indicator" aria-label="Approximate frame rate" title="Smoothed render callbacks per second">FPS @(hasFrameRateSample ? displayedFps.ToString() : "—")</output>
    </main>

    <section class="controls-panel" aria-label="Drawing controls">
        <div class="points-heading">
            <label for="points-slider">Points per dandelion</label>
            <output id="points-value" for="points-slider">@numberOfPoints</output>
        </div>
        <input id="points-slider"
               class="points-slider"
               type="range"
               min="5"
               max="500"
               step="5"
               @bind="numberOfPoints"
               @bind:event="oninput" />

        <div class="count-actions">
            <div class="count-editor">
                <span class="count-label">Dandelions</span>
                <div class="count-stepper" role="group" aria-label="Dandelion count">
                    <button id="remove-one" class="stepper-button" type="button"
                            aria-label="Remove one dandelion"
                            disabled="@(numberOfDandies == 0)"
                            @onclick="() => ChangeDandelions(-1)">−</button>
                    <input id="dandelion-count"
                           class="count-input"
                           type="number"
                           inputmode="numeric"
                           aria-label="Number of dandelions"
                           min="0"
                           max="500"
                           step="1"
                           @bind="DandelionCount" />
                    <button id="add-one" class="stepper-button" type="button"
                            aria-label="Add one dandelion"
                            disabled="@(numberOfDandies == 500)"
                            @onclick="() => ChangeDandelions(1)">+</button>
                </div>
            </div>
            <div class="quick-actions">
                <button id="add-ten" class="secondary-button" type="button"
                        disabled="@(numberOfDandies == 500)"
                        @onclick="() => ChangeDandelions(10)">+10</button>
                <button id="clear-button" class="clear-button" type="button"
                        disabled="@(numberOfDandies == 0)"
                        @onclick="OnClear">Clear</button>
            </div>
        </div>
    </section>
    <footer class="app-footer">
        <span>Move with arrow keys on desktop</span>
        <a href="https://github.com/zackJKnight/blazor-dandelions">See the Code</a>
    </footer>
</div>

@code
{
    int TotalPoints => numberOfPoints * numberOfDandies;
    long fpsWindowStart;
    int framesInWindow;
    double smoothedFps;
    int displayedFps;
    bool hasFrameRateSample;
    double GoldenRatio = 1.61803398874989484820458683436;
    int numberOfPoints = 20;
    int previousTickNumberOfPoints = -1;
    int numberOfDandies = 1;
    int DandelionCount
    {
        get => numberOfDandies;
        set => numberOfDandies = Math.Clamp(value, 0, 500);
    }
    int alpha = 0;
    Random random = new Random();

    int moveSpeed = 1;
    int topSpeed = 15;
    float pointScale = 30.0f;
    float hCenter;
    float vCenter;
    SKPoint[] localPoints = Array.Empty<SKPoint>();
    List<Dandelion> dandelions = new List<Dandelion>();
    // Keep native paint state for the lifetime of the component, not per frame.
    readonly SKPaint dotPaint = new()
    {
        IsAntialias = true,
        StrokeWidth = 3f,
        StrokeCap = SKStrokeCap.Round,
        Style = SKPaintStyle.Stroke
    };
    List<SKColor> colors = new List<SKColor>()
        {
            SKColors.YellowGreen,
            SKColors.Green,
            SKColors.Violet,
            SKColors.WhiteSmoke,
            SKColors.Tomato,
            SKColors.Teal,
            SKColors.SlateGray,
            SKColors.SkyBlue,
            SKColors.Red,
            SKColors.Purple,
            SKColors.Pink,
            SKColors.Plum,
            SKColors.PeachPuff,
            SKColors.PaleGreen,
            SKColors.Orange,
            SKColors.Navy,
            SKColors.Lime
        };
    void OnTouched() => ChangeDandelions(10);
    void ChangeDandelions(int change)
    {
        numberOfDandies = Math.Clamp(numberOfDandies + change, 0, 500);
    }
    void OnClear()
    {
        numberOfDandies = 0;
        OnNumberOfDandiesChanged(0);
    }
    void OnNumberOfDandiesChanged(int newDandyCount)
    {
        if (dandelions.Count < newDandyCount)
        {
            AddDandies((int)(newDandyCount - dandelions.Count()));
        }
        else if (dandelions.Count() > newDandyCount)
        {
            dandelions.RemoveRange((int)newDandyCount, (int)(dandelions.Count() - newDandyCount));
        }
    }
    void AddDandies(int numberToAdd)
    {
        for (int i = 0; i < numberToAdd; i++)
        {

            dandelions.Add(new Dandelion()
            {
                color = colors[random.Next(colors.Count)],
                moveX = random.Next(-((int)hCenter), ((int)hCenter)),
                moveY = random.Next(-((int)vCenter), ((int)vCenter)),
                moveSpeed = moveSpeed,
                moveRight = random.NextDouble() >= 0.5,
                moveUp = random.NextDouble() >= 0.5
            });
        }
    }

    void OnPaintSurface(SKPaintGLSurfaceEventArgs e)
    {
        // Golden-angle geometry is shared by every dandelion, and only changes
        // when the points-per-dandelion control changes.
        if (previousTickNumberOfPoints != numberOfPoints)
        {
            RebuildLocalPoints(numberOfPoints, alpha);
            previousTickNumberOfPoints = numberOfPoints;
        }

        var canvas = e.Surface.Canvas;
        var surfaceSize = e.Info.Size;
        hCenter = surfaceSize.Width / 2f;
        vCenter = surfaceSize.Height / 2f;

        OnNumberOfDandiesChanged(numberOfDandies);
        SampleFrameRate();
        canvas.Clear(SKColors.DarkSlateGray);

        for (int i = 0; i < dandelions.Count; i++)
        {
            var dandy = dandelions[i];
            dandy.moveSpeed = i <= topSpeed ? i + 1 : i % topSpeed + 1;
            dandy.Update(hCenter, vCenter, pointScale);

            // Apply movement once per flower rather than rewriting all its
            // point positions on every render callback.
            dotPaint.Color = dandy.color;
            canvas.Save();
            canvas.Translate(hCenter + dandy.moveX, vCenter + dandy.moveY);
            canvas.DrawPoints(SKPointMode.Points, localPoints, dotPaint);
            canvas.Restore();
        }
    }

    void SampleFrameRate()
    {
        // Stopwatch is monotonic, unlike wall-clock timestamps.
        var now = Stopwatch.GetTimestamp();
        if (fpsWindowStart == 0)
        {
            fpsWindowStart = now;
            return;
        }

        framesInWindow++;
        var elapsed = (now - fpsWindowStart) / (double)Stopwatch.Frequency;
        if (elapsed < 0.75)
            return;

        var sample = framesInWindow / elapsed;
        // A small rolling blend keeps the label legible on variable-rate displays.
        smoothedFps = hasFrameRateSample ? (smoothedFps * 0.65 + sample * 0.35) : sample;
        hasFrameRateSample = true;
        fpsWindowStart = now;
        framesInWindow = 0;

        var rounded = (int)Math.Round(smoothedFps);
        if (rounded != displayedFps)
        {
            displayedFps = rounded;
            // The canvas still animates independently; render the overlay only
            // when the displayed integer changes (never on every paint callback).
            _ = InvokeAsync(StateHasChanged);
        }
    }

    double GetRadius(int k, int n, double b)
    {
        double r = 0.0;

        if (k > (n - b))
        {
            r = 1.0;
        }
        else
        {
            r = Math.Sqrt(k - 1 / 2) / Math.Sqrt(n - (b + 1) / 2);
        }

        return r;
    }

    void RebuildLocalPoints(int n, int alpha)
    {
        var circle = new SKPoint[n];
        double boundaryPointCount = Math.Round(alpha * Math.Sqrt(n));

        for (int k = 1; k <= n; k++)
        {
            double radius = GetRadius(k, n, boundaryPointCount);
            double theta = 2 * Math.PI * k / Math.Pow(GoldenRatio, 2);
            circle[k - 1] = new SKPoint(
                (float)(radius * Math.Cos(theta) * pointScale),
                (float)(radius * Math.Sin(theta) * pointScale));
        }

        localPoints = circle;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight")
            ChangeDandelions(1);
        else if (e.Key == "ArrowLeft")
            ChangeDandelions(-1);
        else if (e.Key == "Enter")
            ChangeDandelions(10);
    }
    public void Dispose()
    {
        dotPaint.Dispose();
    }

}
