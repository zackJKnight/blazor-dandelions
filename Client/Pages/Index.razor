@page "/"
@using SkiaSharp
@using SkiaSharp.Views.Blazor

<PageTitle>Dandelions</PageTitle>

<div class="dandelions-app">
    <header class="app-header">
        <h1>Dandelions</h1>
        <output id="total-points" class="total-count" aria-live="polite">@TotalPoints.ToString("N0") points</output>
    </header>

    <main id="drawing-surface"
          class="canvas-container"
          role="button"
          tabindex="0"
          aria-label="Animated drawing. Tap to add ten dandelions. Use arrow keys to adjust the count."
          @onclick="OnTouched"
          @onkeydown="HandleKeyDown">
        <SKGLView OnPaintSurface="OnPaintSurface" IgnorePixelScaling="true" EnableRenderLoop="true" />
        <span class="canvas-hint" aria-hidden="true">Tap drawing to add 10</span>
    </main>

    <section class="controls-panel" aria-label="Drawing controls">
        <div class="points-heading">
            <label for="points-slider">Points per dandelion</label>
            <output id="points-value" for="points-slider">@numberOfPoints</output>
        </div>
        <input id="points-slider"
               class="points-slider"
               type="range"
               min="5"
               max="500"
               step="5"
               @bind="numberOfPoints"
               @bind:event="oninput" />

        <div class="count-actions">
            <div class="count-editor">
                <span class="count-label">Dandelions</span>
                <div class="count-stepper" role="group" aria-label="Dandelion count">
                    <button id="remove-one" class="stepper-button" type="button"
                            aria-label="Remove one dandelion"
                            disabled="@(numberOfDandies == 0)"
                            @onclick="() => ChangeDandelions(-1)">−</button>
                    <input id="dandelion-count"
                           class="count-input"
                           type="number"
                           inputmode="numeric"
                           aria-label="Number of dandelions"
                           min="0"
                           max="500"
                           step="1"
                           @bind="DandelionCount" />
                    <button id="add-one" class="stepper-button" type="button"
                            aria-label="Add one dandelion"
                            disabled="@(numberOfDandies == 500)"
                            @onclick="() => ChangeDandelions(1)">+</button>
                </div>
            </div>
            <div class="quick-actions">
                <button id="add-ten" class="secondary-button" type="button"
                        disabled="@(numberOfDandies == 500)"
                        @onclick="() => ChangeDandelions(10)">+10</button>
                <button id="clear-button" class="clear-button" type="button"
                        disabled="@(numberOfDandies == 0)"
                        @onclick="OnClear">Clear</button>
            </div>
        </div>
    </section>
    <footer class="app-footer">
        <span>Move with arrow keys on desktop</span>
        <a href="https://github.com/zackJKnight/blazor-dandelions">See the Code</a>
    </footer>
</div>

@code
{
    int TotalPoints => numberOfPoints * numberOfDandies;
    int tickIndex = 0;
    long tickSum = 0;
    long[] tickList = new long[100];
    long lastTick = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    double GoldenRatio = 1.61803398874989484820458683436;
    int numberOfPoints = 20;
    int previousTickNumberOfPoints = -1;
    int numberOfDandies = 1;
    int DandelionCount
    {
        get => numberOfDandies;
        set => numberOfDandies = Math.Clamp(value, 0, 500);
    }
    int alpha = 0;
    Random random = new Random();

    int moveSpeed = 1;
    int topSpeed = 15;
    float pointScale = 30.0f;
    float hCenter;
    float vCenter;
    List<float[]> points = new List<float[]>();
    List<Dandelion> dandelions = new List<Dandelion>();
    List<SKColor> colors = new List<SKColor>()
        {
            SKColors.YellowGreen,
            SKColors.Green,
            SKColors.Violet,
            SKColors.WhiteSmoke,
            SKColors.Tomato,
            SKColors.Teal,
            SKColors.SlateGray,
            SKColors.SkyBlue,
            SKColors.Red,
            SKColors.Purple,
            SKColors.Pink,
            SKColors.Plum,
            SKColors.PeachPuff,
            SKColors.PaleGreen,
            SKColors.Orange,
            SKColors.Navy,
            SKColors.Lime
        };
    void OnTouched() => ChangeDandelions(10);
    void ChangeDandelions(int change)
    {
        numberOfDandies = Math.Clamp(numberOfDandies + change, 0, 500);
    }
    void OnClear()
    {
        numberOfDandies = 0;
        OnNumberOfDandiesChanged(0);
    }
    void OnNumberOfDandiesChanged(int newDandyCount)
    {
        if (dandelions.Count() < newDandyCount)
        {
            AddDandies((int)(newDandyCount - dandelions.Count()));
        }
        else if (dandelions.Count() > newDandyCount)
        {
            dandelions.RemoveRange((int)newDandyCount, (int)(dandelions.Count() - newDandyCount));
        }
    }
    void AddDandies(int numberToAdd)
    {
        for (float i = 0; i < numberToAdd; i++)
        {

            dandelions.Add(new Dandelion()
            {
                points = new SKPoint[numberOfPoints],
                color = colors.ElementAt(random.Next(colors.Count())),
                moveX = random.Next(-((int)hCenter), ((int)hCenter)),
                moveY = random.Next(-((int)vCenter), ((int)vCenter)),
                moveSpeed = moveSpeed,
                moveRight = random.NextDouble() >= 0.5,
                moveUp = random.NextDouble() >= 0.5
            });
        }
    }

    void OnPaintSurface(SKPaintGLSurfaceEventArgs e)
    {
        //if prevTickNumberOfPoints not equal numberOfPoints, clear points. otherwise leave them?????
        if(previousTickNumberOfPoints != numberOfPoints)
        {
            points.Clear();
            FillCircleWithPoints(numberOfPoints, alpha);
            previousTickNumberOfPoints = numberOfPoints;
            for (int i = 0; i < dandelions.Count(); i++)
            {
                dandelions.ElementAt(i).points = new SKPoint[numberOfPoints];
            }
        }
        
                // the the canvas and properties
        SKCanvas canvas = e.Surface.Canvas;
        var surfaceSize = e.Info.Size;

        hCenter = (surfaceSize.Width / 2f);
        vCenter = (surfaceSize.Height / 2f);
        if (!dandelions.Any())
        {
            AddDandies(numberOfDandies);
        }

        OnNumberOfDandiesChanged(numberOfDandies);
        var fps = GetCurrentFPS();

        var now = DateTime.Now;

        // make sure the canvas is blank
        canvas.Clear(SKColors.DarkSlateGray);
        using var textPaint = new SKPaint
        {
            IsAntialias = true,
            StrokeWidth = 6f,
            StrokeCap = SKStrokeCap.Round,
            TextAlign = SKTextAlign.Center,
            TextSize = 32,
            Style = SKPaintStyle.Fill,
            Color = SKColors.Red
        };
        // draw the fps counter

        canvas.DrawText($"{fps:0.00}", hCenter, surfaceSize.Height - 10f, textPaint);
        // background
        using var paint = new SKPaint
        {
            IsAntialias = true,
            StrokeWidth = 3f,
            StrokeCap = SKStrokeCap.Round,
            TextAlign = SKTextAlign.Center,
            TextSize = 24,
            Style = SKPaintStyle.Fill,

        };

        // Region
        paint.Style = SKPaintStyle.Stroke;

        for (float i = 0; i < numberOfDandies; i++)
        {
            var dandy = dandelions.ElementAt((int)i);
            dandy.moveSpeed = (int)i <= topSpeed ? (int)i + 1 : (int) i% topSpeed + 1;
            // higher the x and y, the more right and down
            dandy.Update(hCenter, vCenter, pointScale);

            for (int j = 0; j < points.Count(); j ++)
            {
                dandy.points[j].X = (points[j][0] * pointScale) + hCenter + dandy.moveX;
                dandy.points[j].Y = (points[j][1] * pointScale) + vCenter + dandy.moveY;
            }
        }

        dandelions.ForEach((dandy) =>
        {
            paint.Color = dandy.color;
            canvas.DrawPoints(
            SKPointMode.Points,
            dandy.points,
            paint);
        });

        paint.Style = SKPaintStyle.Fill;

    }

    double GetCurrentFPS()
    {
        var newTick = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var delta = newTick - lastTick;
        lastTick = newTick;

        tickSum -= tickList[tickIndex];
        tickSum += delta;
        tickList[tickIndex] = delta;

        if (++tickIndex == tickList.Length)
        {
            tickIndex = 0;
        }

        return 1000.0 / ((double)tickSum / tickList.Length);
    }

    double GetRadius(int k, int n, double b)
    {
        double r = 0.0;

        if (k > (n - b))
        {
            r = 1.0;
        }
        else
        {
            r = Math.Sqrt(k - 1 / 2) / Math.Sqrt(n - (b + 1) / 2);
        }

        return r;
    }

    void FillCircleWithPoints(int n, int alpha)
    {
        double boundaryPointCount = Math.Round(alpha * Math.Sqrt(n)); // % number of boundary points
        for (int k = 1; k <= n; k++)
        {
            double r = GetRadius(k, n, boundaryPointCount);
            var theta = 2 * Math.PI * k / Math.Pow(GoldenRatio, 2);

            float x = (float)(r * Math.Cos(theta));
            float y = (float)(r * Math.Sin(theta));
            points.Add(new[] { x, y });
        }

    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight")
            ChangeDandelions(1);
        else if (e.Key == "ArrowLeft")
            ChangeDandelions(-1);
        else if (e.Key == "Enter")
            ChangeDandelions(10);
    }
}
